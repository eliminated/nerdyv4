<?xml version="1.0" encoding="utf-8"?>
<!--
    Nerdy design tokens. Light values come straight from the prototype; dark values are their counterparts.
    Accent-derived brushes are placeholders: ThemeService recolours these exact instances at runtime when the
    user picks an accent, which updates every {ThemeResource} reference live.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NerdyTextPrimaryBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="NerdyTextStrongBrush" Color="#3A3A44" />
            <SolidColorBrush x:Key="NerdyTextSecondaryBrush" Color="#5F5F6B" />
            <SolidColorBrush x:Key="NerdyTextTertiaryBrush" Color="#9A9AA6" />

            <SolidColorBrush x:Key="NerdyContentBackgroundBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="NerdyContentBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="NerdyCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NerdyCardBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="NerdyCardAltBackgroundBrush" Color="#FAFAFC" />
            <SolidColorBrush x:Key="NerdyPopupBackgroundBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="NerdyInputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NerdyControlBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="NerdyControlBorderStrongBrush" Color="#59000000" />
            <SolidColorBrush x:Key="NerdyOutlineButtonHoverBrush" Color="#F7F7F9" />

            <SolidColorBrush x:Key="NerdySubtleHoverBrush" Color="#0B000000" />
            <SolidColorBrush x:Key="NerdySubtlePressedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="NerdySubtleFillBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="NerdyTrackBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="NerdyDividerBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="NerdyGridLineBrush" Color="#12000000" />
            <SolidColorBrush x:Key="NerdyWeekendColumnBrush" Color="#04000000" />
            <SolidColorBrush x:Key="NerdySegmentTrackBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="NerdySegmentSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NerdyKbdBackgroundBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="NerdySearchBackgroundBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="NerdyPillAuraBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="NerdyTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NerdyIconTileBrush" Color="#F3F3F7" />
            <SolidColorBrush x:Key="NerdyGlassBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="NerdyGlassStrongBrush" Color="#D1FFFFFF" />
            <SolidColorBrush x:Key="NerdyGlassFaintBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="NerdyChipBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="NerdyOverlayCardBrush" Color="#E0FFFFFF" />

            <SolidColorBrush x:Key="NerdyDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="NerdyDangerSoftBrush" Color="#FDECEA" />
            <SolidColorBrush x:Key="NerdyDangerTextBrush" Color="#9B1C10" />
            <SolidColorBrush x:Key="NerdyDangerBorderBrush" Color="#F3C4BE" />
            <SolidColorBrush x:Key="NerdyDangerCardBrush" Color="#FFFAF9" />
            <SolidColorBrush x:Key="NerdySuccessBrush" Color="#1F9D74" />
            <SolidColorBrush x:Key="NerdySuccessSoftBrush" Color="#E8F6EF" />
            <SolidColorBrush x:Key="NerdySuccessTextBrush" Color="#14774F" />
            <SolidColorBrush x:Key="NerdyWarningBrush" Color="#E8743B" />
            <SolidColorBrush x:Key="NerdyWarningSoftBrush" Color="#FFF4E5" />
            <SolidColorBrush x:Key="NerdyWarningTextBrush" Color="#B45309" />
            <SolidColorBrush x:Key="NerdyStarBrush" Color="#E8A33B" />
            <SolidColorBrush x:Key="NerdyOnlineBrush" Color="#1F9D74" />

            <!-- Accent family (recoloured at runtime). -->
            <SolidColorBrush x:Key="NerdyAccentBrush" Color="#5B5BD6" />
            <SolidColorBrush x:Key="NerdyAccentSoftBrush" Color="#EFEFFB" />
            <SolidColorBrush x:Key="NerdyAccentSoftBorderBrush" Color="#E0E0F7" />
            <SolidColorBrush x:Key="NerdyAccentTint8Brush" Color="#F1F1FC" />
            <SolidColorBrush x:Key="NerdyAccentTint14Brush" Color="#E6E6F9" />
            <SolidColorBrush x:Key="NerdyAccentTint30Brush" Color="#CECEF3" />
            <SolidColorBrush x:Key="NerdyAccentTextBrush" Color="#4949AB" />
            <SolidColorBrush x:Key="NerdyOnAccentBrush" Color="#FFFFFF" />

            <!-- WinUI accent resources, overridden so built-in controls follow Nerdy's accent instead of the system one. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5B5BD6" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E65B5BD6" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC5B5BD6" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4949AB" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#4949AB" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#5B5BD6" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#5B5BD6" />
            <!-- Focused text box underline: WinUI builds it from raw accent colours, so Nerdy owns this instance too. -->
            <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
                <LinearGradientBrush.RelativeTransform>
                    <ScaleTransform CenterY="0.5" ScaleY="-1" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Offset="1.0" Color="#5B5BD6" />
                <GradientStop Offset="1.0" Color="#0F000000" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NerdyTextPrimaryBrush" Color="#F2F2F5" />
            <SolidColorBrush x:Key="NerdyTextStrongBrush" Color="#D9D9E0" />
            <SolidColorBrush x:Key="NerdyTextSecondaryBrush" Color="#A9A9B5" />
            <SolidColorBrush x:Key="NerdyTextTertiaryBrush" Color="#7C7C88" />

            <SolidColorBrush x:Key="NerdyContentBackgroundBrush" Color="#4C3A3A3A" />
            <SolidColorBrush x:Key="NerdyContentBorderBrush" Color="#19000000" />
            <SolidColorBrush x:Key="NerdyCardBackgroundBrush" Color="#2A2A2E" />
            <SolidColorBrush x:Key="NerdyCardBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NerdyCardAltBackgroundBrush" Color="#26262A" />
            <SolidColorBrush x:Key="NerdyPopupBackgroundBrush" Color="#F72C2C30" />
            <SolidColorBrush x:Key="NerdyInputBackgroundBrush" Color="#1F1F23" />
            <SolidColorBrush x:Key="NerdyControlBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NerdyControlBorderStrongBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="NerdyOutlineButtonHoverBrush" Color="#333338" />

            <SolidColorBrush x:Key="NerdySubtleHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NerdySubtlePressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="NerdySubtleFillBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NerdyTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NerdyDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NerdyGridLineBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="NerdyWeekendColumnBrush" Color="#06FFFFFF" />
            <SolidColorBrush x:Key="NerdySegmentTrackBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NerdySegmentSelectedBrush" Color="#3A3A40" />
            <SolidColorBrush x:Key="NerdyKbdBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NerdySearchBackgroundBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NerdyPillAuraBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NerdyTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NerdyIconTileBrush" Color="#36363D" />
            <SolidColorBrush x:Key="NerdyGlassBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="NerdyGlassStrongBrush" Color="#3AFFFFFF" />
            <SolidColorBrush x:Key="NerdyGlassFaintBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NerdyChipBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="NerdyOverlayCardBrush" Color="#E62A2A2E" />

            <SolidColorBrush x:Key="NerdyDangerBrush" Color="#FF6B5E" />
            <SolidColorBrush x:Key="NerdyDangerSoftBrush" Color="#3D211F" />
            <SolidColorBrush x:Key="NerdyDangerTextBrush" Color="#FFA197" />
            <SolidColorBrush x:Key="NerdyDangerBorderBrush" Color="#6B2F2A" />
            <SolidColorBrush x:Key="NerdyDangerCardBrush" Color="#2E2322" />
            <SolidColorBrush x:Key="NerdySuccessBrush" Color="#3CC594" />
            <SolidColorBrush x:Key="NerdySuccessSoftBrush" Color="#16352B" />
            <SolidColorBrush x:Key="NerdySuccessTextBrush" Color="#7FDDB7" />
            <SolidColorBrush x:Key="NerdyWarningBrush" Color="#F08D58" />
            <SolidColorBrush x:Key="NerdyWarningSoftBrush" Color="#3B2C17" />
            <SolidColorBrush x:Key="NerdyWarningTextBrush" Color="#F5BD6E" />
            <SolidColorBrush x:Key="NerdyStarBrush" Color="#F2B34F" />
            <SolidColorBrush x:Key="NerdyOnlineBrush" Color="#3CC594" />

            <SolidColorBrush x:Key="NerdyAccentBrush" Color="#5B5BD6" />
            <SolidColorBrush x:Key="NerdyAccentSoftBrush" Color="#2C2C47" />
            <SolidColorBrush x:Key="NerdyAccentSoftBorderBrush" Color="#3A3A63" />
            <SolidColorBrush x:Key="NerdyAccentTint8Brush" Color="#28283C" />
            <SolidColorBrush x:Key="NerdyAccentTint14Brush" Color="#30304D" />
            <SolidColorBrush x:Key="NerdyAccentTint30Brush" Color="#40406E" />
            <SolidColorBrush x:Key="NerdyAccentTextBrush" Color="#A7A7F0" />
            <SolidColorBrush x:Key="NerdyOnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5B5BD6" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E65B5BD6" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC5B5BD6" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A7A7F0" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A7A7F0" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8C8CE8" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#8C8CE8" />
            <!-- Focused text box underline: WinUI builds it from raw accent colours, so Nerdy owns this instance too. -->
            <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
                <LinearGradientBrush.RelativeTransform>
                    <ScaleTransform CenterY="0.5" ScaleY="-1" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Offset="1.0" Color="#8C8CE8" />
                <GradientStop Offset="1.0" Color="#12FFFFFF" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
