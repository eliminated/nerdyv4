<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:services="using:Nerdy.App.Services"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:h="using:Nerdy.App.Helpers"
    FontFamily="{x:Bind Theme.FontFamily, Mode=OneWay}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="OnTogglePaneAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnSearchAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <TitleBar x:Name="AppTitleBar" Title="Nerdy" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Button Style="{StaticResource PlainButtonStyle}" Width="40" Height="36" Margin="4,0,2,0"
                        Command="{x:Bind ViewModel.TogglePaneCommand}"
                        ToolTipService.ToolTip="Collapse or expand the sidebar (Ctrl+B)"
                        AutomationProperties.Name="Toggle sidebar">
                    <controls:PaneToggleGlyph IsOpen="{x:Bind ViewModel.IsPaneOpen, Mode=OneWay}" Foreground="{ThemeResource NerdyTextPrimaryBrush}" />
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/NerdyLogo32.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Width="420" HorizontalAlignment="Center">
                    <AutoSuggestBox x:Name="SearchBox"
                                    PlaceholderText="Search notes, topics, reminders"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.SearchResults}"
                                    TextChanged="OnSearchTextChanged"
                                    SuggestionChosen="OnSearchSuggestionChosen"
                                    QuerySubmitted="OnSearchQuerySubmitted"
                                    GotFocus="OnSearchFocusChanged"
                                    LostFocus="OnSearchFocusChanged"
                                    AutomationProperties.Name="Search">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SearchResult">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="18" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource NerdyBodyStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource NerdyCaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <Border x:Name="SearchHint" Style="{StaticResource NerdyKbdStyle}" HorizontalAlignment="Right" Margin="0,0,40,0" IsHitTestVisible="False">
                        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                    </Border>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Width="232" Padding="8,4,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sliding selection pill (glide / aura / horizon). -->
                <Border x:Name="Pill" Grid.RowSpan="2" VerticalAlignment="Top" Height="38" CornerRadius="8" Opacity="0"
                        Background="{x:Bind ViewModel.PillBackground, Mode=OneWay}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PillTranslate" />
                    </Border.RenderTransform>
                    <Grid>
                        <controls:OrbitGlow Visibility="{x:Bind ViewModel.ShowOrbit, Mode=OneWay}"
                                            Colors="{x:Bind ViewModel.OrbitColors, Mode=OneWay}"
                                            Mode="{x:Bind ViewModel.OrbitMode, Mode=OneWay}" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                   Fill="{ThemeResource NerdyAccentBrush}" Visibility="{x:Bind ViewModel.ShowAccentBar, Mode=OneWay}" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="NavList" ItemsSource="{x:Bind ViewModel.NavItems}" VerticalAlignment="Top" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <Button Style="{StaticResource PlainButtonStyle}"
                                    Height="38" Padding="10,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{x:Bind NavigateCommand}"
                                    ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Label}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="20" Foreground="{x:Bind IconBrush, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Label}" FontWeight="{x:Bind Weight, Mode=OneWay}" Opacity="{x:Bind LabelOpacity, Mode=OneWay}"
                                               VerticalAlignment="Center" Foreground="{ThemeResource NerdyTextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Profile (opens the account menu). -->
                <Button x:Name="ProfileButton" Grid.Row="1" Style="{StaticResource PlainButtonStyle}" CornerRadius="10"
                        Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ProfileToolTip, Mode=OneWay}"
                        AutomationProperties.Name="Account menu">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="{ThemeResource NerdyAccentTint30Brush}" />
                            <TextBlock Text="{x:Bind ViewModel.Initials, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource NerdyAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                     Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" Stroke="{ThemeResource NerdyCardBackgroundBrush}" StrokeThickness="2"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{x:Bind h:B.Opacity(ViewModel.IsPaneOpen), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                            <TextBlock Text="{x:Bind ViewModel.RoleLabel, Mode=OneWay}" Style="{StaticResource NerdyCaptionStyle}" />
                        </StackPanel>
                        <fi:SymbolIcon Grid.Column="2" Symbol="ChevronUp" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}"
                                       VerticalAlignment="Center" Opacity="{x:Bind h:B.Opacity(ViewModel.IsPaneOpen), Mode=OneWay}" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="ProfileFlyout" Placement="TopEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="MinWidth" Value="248" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="236">
                                <Grid ColumnSpacing="10" Padding="10,10,10,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40">
                                        <Ellipse Fill="{ThemeResource NerdyAccentTint30Brush}" />
                                        <TextBlock Text="{x:Bind ViewModel.Initials, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource NerdyAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" Style="{StaticResource NerdyStrongStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" Style="{StaticResource NerdyCaptionStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource NerdyCaptionStyle}" Foreground="{ThemeResource NerdyTextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource NerdyDividerStyle}" Margin="4,0,4,4" />
                                <Button Style="{StaticResource PlainButtonStyle}" Height="36" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnProfileAccount" AutomationProperties.Name="Profile &amp; account">
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="Person" FontSize="20" Foreground="{ThemeResource NerdyTextStrongBrush}" />
                                        <TextBlock Grid.Column="1" Text="Profile &amp; account" VerticalAlignment="Center" Style="{StaticResource NerdyBodyStyle}" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource PlainButtonStyle}" Height="36" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnProfileSettings" AutomationProperties.Name="Settings">
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="Settings" FontSize="20" Foreground="{ThemeResource NerdyTextStrongBrush}" />
                                        <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" Style="{StaticResource NerdyBodyStyle}" />
                                        <TextBlock Grid.Column="2" Text="Ctrl+," VerticalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource PlainButtonStyle}" Height="36" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnProfileHelp" AutomationProperties.Name="Help &amp; feedback">
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="QuestionCircle" FontSize="20" Foreground="{ThemeResource NerdyTextStrongBrush}" />
                                        <TextBlock Grid.Column="1" Text="Help &amp; feedback" VerticalAlignment="Center" Style="{StaticResource NerdyBodyStyle}" />
                                    </Grid>
                                </Button>
                                <Rectangle Style="{StaticResource NerdyDividerStyle}" Margin="4" />
                                <Button Style="{StaticResource PlainButtonStyle}" Height="36" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnSignOut" AutomationProperties.Name="Sign out">
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="SignOut" FontSize="20" Foreground="{ThemeResource NerdyTextStrongBrush}" />
                                        <TextBlock Grid.Column="1" Text="Sign out" VerticalAlignment="Center" Style="{StaticResource NerdyBodyStyle}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Border Grid.Column="1"
                    Background="{ThemeResource NerdyContentBackgroundBrush}"
                    BorderBrush="{ThemeResource NerdyContentBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0">
                <Frame x:Name="ContentFrame" />
            </Border>
        </Grid>
    </Grid>
</Page>
