<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:h="using:Nerdy.App.Helpers"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <ScrollViewer Padding="28,22,28,32">
        <StackPanel Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="12" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Statistics &amp; History" FontSize="24" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                    <TextBlock Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource NerdySegmentTrackStyle}" CornerRadius="10" VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Ranges}" ItemTemplate="{StaticResource NerdySegmentTemplate}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
                </Border>
            </Grid>

            <!-- First run -->
            <Border Style="{StaticResource NerdyCardStyle}" Visibility="{x:Bind h:B.Collapsed(ViewModel.HasData), Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource NerdyAccentSoftBrush}">
                        <fi:SymbolIcon Symbol="DataTrending" FontSize="20" Foreground="{ThemeResource NerdyAccentTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="No focus sessions yet" Style="{StaticResource NerdyStrongStyle}" />
                        <TextBlock Text="Sessions longer than a minute show up here, with your patterns and history." Style="{StaticResource NerdySecondaryWrapStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource NerdyAccentButtonStyle}" Content="Start a focus session" Command="{x:Bind ViewModel.StartFocusCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- KPIs -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Kpis}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <tk:UniformGrid Rows="1" ColumnSpacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KpiCard">
                        <Border Style="{StaticResource NerdyCardStyle}" Padding="18,16">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource NerdySecondaryStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Value}" Style="{StaticResource NerdyMetricStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border CornerRadius="10" Padding="4,1,8,1" Background="{x:Bind DeltaBackground}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <fi:SymbolIcon Symbol="{x:Bind DeltaIcon}" FontSize="14" Foreground="{x:Bind DeltaForeground}" Visibility="{x:Bind HasDelta}" />
                                            <TextBlock Text="{x:Bind Delta}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind DeltaForeground}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Bind Versus}" Style="{StaticResource NerdyCaptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Chart + topics -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource NerdyCardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="14" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Focus time" Style="{StaticResource NerdyCardTitleStyle}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Legend}" HorizontalAlignment="Right" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <tk:WrapPanel HorizontalSpacing="14" VerticalSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="8" Height="8" CornerRadius="3" Background="{x:Bind Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource NerdyCaptionStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Height="200" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <!-- Overhangs the plot by half a label so the top and bottom labels aren't clipped -->
                            <ItemsControl Grid.ColumnSpan="2" Margin="0,-8" ItemsSource="{x:Bind ViewModel.GridLines}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GridLine">
                                        <Grid Height="16" VerticalAlignment="Bottom" Margin="{x:Bind h:B.GridLineMargin(Bottom)}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Height="1" Background="{ThemeResource NerdyGridLineBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Bars}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <tk:UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartBar">
                                        <Grid Background="{ThemeResource NerdyTransparentBrush}" Margin="{x:Bind Gap}">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Visibility="{x:Bind HasData}">
                                                    <StackPanel MinWidth="150">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Total}" Opacity="0.75" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{x:Bind Rows}" IsTabStop="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:TipRow">
                                                                    <Grid ColumnSpacing="6" Padding="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="7" Height="7" CornerRadius="2" Background="{x:Bind Color}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Margin="0,0,10,0" />
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind Time}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                            <ItemsControl ItemsSource="{x:Bind Segments}" VerticalAlignment="Bottom" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BarSegment">
                                                        <Border Height="{x:Bind Height}" Background="{x:Bind Fill}" CornerRadius="{x:Bind Corners}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Bars}" Margin="34,8,0,0" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartBar">
                                    <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{x:Bind LabelBrush}" FontWeight="{x:Bind LabelWeight}"
                                               HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NerdyCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Time by topic" Style="{StaticResource NerdyCardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TopicSummary, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" Margin="0,0,0,14" />
                        <Border Height="10" CornerRadius="6" Background="{ThemeResource NerdySubtleFillBrush}" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopicRows}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ShareBarPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TopicTimeRow">
                                        <Border Background="{x:Bind Color}" Height="10" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopicRows}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopicTimeRow">
                                    <Button Style="{StaticResource PlainButtonStyle}" Command="{x:Bind OpenCommand}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="6,9" CornerRadius="8" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{x:Bind Color}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" Style="{StaticResource NerdyTextBase}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Sessions}" Style="{StaticResource NerdyCaptionStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource NerdyStrongStyle}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Percent}" Style="{StaticResource NerdyCaptionStyle}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No focus time in this period." Style="{StaticResource NerdySecondaryStyle}"
                                   Visibility="{x:Bind h:B.NoItems(ViewModel.TopicRows.Count), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Heatmap + insights + Ultra record -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource NerdyCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="When you focus" Style="{StaticResource NerdyCardTitleStyle}" />
                                <TextBlock Text="Minutes of focus by start hour" Style="{StaticResource NerdySecondaryStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="Less" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HeatLegend}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="media:Brush">
                                            <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,4,0" Background="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="More" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Heat}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HeatRow">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <tk:UniformGrid Rows="1" ColumnSpacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HeatCell">
                                                    <Border Height="24" CornerRadius="5" Background="{x:Bind Fill}" ToolTipService.ToolTip="{x:Bind Tip}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.HourLabels}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <tk:UniformGrid Rows="1" ColumnSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="11" Foreground="{ThemeResource NerdyTextSecondaryBrush}" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource NerdyCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Insights" Style="{StaticResource NerdyCardTitleStyle}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Insights}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Insight">
                                        <Grid ColumnSpacing="12" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{x:Bind Background}" VerticalAlignment="Top">
                                                <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="16" Foreground="{x:Bind Foreground}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource NerdyBodyWrapStyle}" FontSize="13" LineHeight="19" Padding="0,5,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource NerdyCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <fi:SymbolIcon Symbol="ShieldLock" FontSize="20" Foreground="{ThemeResource NerdyAccentBrush}" />
                                <TextBlock Text="Ultra-Focus record" Style="{StaticResource NerdyCardTitleStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.UltraValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                                <TextBlock Text="sessions held to the end" Style="{StaticResource NerdySecondaryStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <controls:ProgressTrack Value="{x:Bind ViewModel.UltraPercent, Mode=OneWay}" Height="6" CornerRadius="3" Margin="0,10,0,12"
                                                    Fill="{ThemeResource NerdyAccentBrush}" />
                            <TextBlock Text="No emergency exits in this period." Style="{StaticResource NerdySecondaryStyle}" Visibility="{x:Bind ViewModel.NoExits, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Exits}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExitRow">
                                        <Grid ColumnSpacing="10" Padding="0,8" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <fi:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{ThemeResource NerdyDangerBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Reason}" Style="{StaticResource NerdyStrongStyle}" FontSize="13" />
                                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource NerdyCaptionStyle}" />
                                                <TextBlock Text="{x:Bind Quote}" Style="{StaticResource NerdyCaptionWrapStyle}" Foreground="{ThemeResource NerdyTextStrongBrush}"
                                                           Margin="0,2,0,0" Visibility="{x:Bind HasNote}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- History -->
            <Border Style="{StaticResource NerdyCardStyle}" Padding="0">
                <StackPanel>
                    <Grid Padding="20,16,20,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Session history" Style="{StaticResource NerdyCardTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.HistoryCount, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource NerdySegmentTrackStyle}" CornerRadius="10" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Filters}" ItemTemplate="{StaticResource NerdySegmentTemplate}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
                        </Border>
                    </Grid>
                    <Grid ColumnSpacing="16" Padding="20,8" Background="{ThemeResource NerdyCardAltBackgroundBrush}" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Date" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Session" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Topic" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Mode" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Duration" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Outcome" Style="{StaticResource NerdyCaptionStyle}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="No sessions match this filter." Style="{StaticResource NerdySecondaryStyle}" HorizontalAlignment="Center" Margin="0,24"
                               Visibility="{x:Bind ViewModel.HistoryEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.History}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRow">
                                <StackPanel Padding="20,11" Background="{x:Bind RowBackground}" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Date}" FontSize="13" FontWeight="Medium" Style="{StaticResource NerdyTextBase}" />
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource NerdyCaptionStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Task}" FontWeight="Medium" Style="{StaticResource NerdyTextBase}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{x:Bind Dot}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Topic}" FontSize="13" Style="{StaticResource NerdyTextBase}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <fi:SymbolIcon Symbol="{x:Bind ModeIcon}" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Mode}" FontSize="13" Style="{StaticResource NerdyTextBase}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" FontSize="13" Style="{StaticResource NerdyTextBase}" VerticalAlignment="Center" />
                                        <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12" Padding="10,3" Background="{x:Bind PillBackground}">
                                            <TextBlock Text="{x:Bind Outcome}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind PillForeground}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="146,6,0,0" Visibility="{x:Bind HasNote}">
                                        <fi:SymbolIcon Symbol="Info" FontSize="16" Foreground="{ThemeResource NerdyDangerTextBrush}" />
                                        <TextBlock Text="{x:Bind Note}" FontSize="12" Foreground="{ThemeResource NerdyDangerTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Stretch" Padding="12" CornerRadius="0,0,14,14"
                            Command="{x:Bind ViewModel.ShowMoreCommand}" Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fi:SymbolIcon Symbol="ChevronDown" FontSize="16" Foreground="{ThemeResource NerdyAccentTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MoreText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NerdyAccentTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
