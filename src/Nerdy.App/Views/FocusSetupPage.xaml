<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.FocusSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:common="using:Nerdy.App.ViewModels.Common">

    <Page.Resources>
        <DataTemplate x:Key="ModeCardTemplate" x:DataType="common:ChoiceItem">
            <Button Style="{StaticResource PlainButtonStyle}" Padding="18" CornerRadius="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="2"
                    Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Label}">
                <Button.RenderTransform>
                    <TranslateTransform Y="{x:Bind Lift, Mode=OneWay}" />
                </Button.RenderTransform>
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="{x:Bind IconBackground, Mode=OneWay}">
                            <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="20" Foreground="{x:Bind IconForeground, Mode=OneWay}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
                        <RadioButton Grid.Column="2" IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False" MinWidth="0" IsTabStop="False" />
                    </Grid>
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource NerdySecondaryWrapStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,22">
            <StackPanel>
                <TextBlock Text="Focus" FontSize="24" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                <TextBlock Text="Hide distractions and stay with one thing." Margin="0,0,0,20" Style="{StaticResource NerdySecondaryStyle}" FontSize="14" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="16">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ModeCards}" ItemTemplate="{StaticResource ModeCardTemplate}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Columns="2" ColumnSpacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Style="{StaticResource NerdyCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duration" Style="{StaticResource NerdyStrongStyle}" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationUnit, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource NerdySecondaryStyle}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DurationChips}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <tk:UniformGrid Rows="1" ColumnSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="common:ChoiceItem">
                                            <Button Style="{StaticResource PlainButtonStyle}" Height="34" HorizontalAlignment="Stretch"
                                                    Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="1"
                                                    Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Label}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="16" Foreground="{x:Bind Foreground, Mode=OneWay}" Visibility="{x:Bind HasIcon}" />
                                                    <TextBlock Text="{x:Bind Label}" FontSize="13" FontWeight="Medium" Foreground="{x:Bind Foreground, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{x:Bind ViewModel.IsCustom, Mode=OneWay}" Spacing="14" Margin="0,16,0,0" Padding="0,16,0,0"
                                            BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,1,0,0">
                                    <Slider Minimum="1" Maximum="240" StepFrequency="1" Value="{x:Bind ViewModel.SliderMinutes, Mode=TwoWay}"
                                            AutomationProperties.Name="Duration in minutes" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox Header="Hours" Minimum="0" Maximum="12" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CustomHours, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="1" Header="Minutes" Minimum="0" Maximum="59" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CustomMinutes, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="2" Header="Seconds" Minimum="0" Maximum="59" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CustomSeconds, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NerdyCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="What are you working on?" Style="{StaticResource NerdyStrongStyle}" />
                                <TextBox PlaceholderText="e.g. Methods draft" Style="{StaticResource NerdyTextBoxStyle}" Text="{x:Bind ViewModel.TaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="What are you working on" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SubjectChips}" ItemTemplate="{StaticResource NerdyColorChipTemplate}" IsTabStop="False"
                                              AutomationProperties.Name="Subject">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <tk:WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasTopicChips, Mode=OneWay}">
                                    <TextBlock Text="Topic (optional)" Style="{StaticResource NerdyCaptionStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopicChips}" ItemTemplate="{StaticResource NerdyPillChipTemplate}" IsTabStop="False"
                                                  AutomationProperties.Name="Topic">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <tk:WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Allowed apps and websites -->
                    <Border Grid.Column="1" Style="{StaticResource NerdyCardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Allowed during session" Style="{StaticResource NerdyStrongStyle}" />
                                <Button Style="{StaticResource NerdyLinkButtonStyle}" Content="Add app" HorizontalAlignment="Right" Padding="0" Click="OnAddAppClick">
                                    <Button.Flyout>
                                        <Flyout x:Name="AddAppFlyout" Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="300" Spacing="8">
                                                <TextBlock Text="Allow an app" Style="{StaticResource NerdyStrongStyle}" />
                                                <ListView x:Name="AddableList" ItemsSource="{x:Bind ViewModel.AddableApps}" MaxHeight="340" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAddableClick">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:AddableApp">
                                                            <StackPanel Padding="0,6">
                                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource NerdyBodyStyle}" />
                                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NerdyCaptionStyle}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.BlockingText, Mode=OneWay}" Margin="0,2,0,8" Style="{StaticResource NerdySecondaryWrapStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AllowedAppRowViewModel">
                                        <Grid ColumnSpacing="12" Padding="0,9" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource NerdyIconTileBrush}">
                                                <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="20" Foreground="{ThemeResource NerdyTextStrongBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" Style="{StaticResource NerdyTextBase}" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource NerdyCaptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Enabled, Mode=TwoWay}" IsEnabled="{x:Bind CanRemove}" Opacity="{x:Bind LockedOpacity}"
                                                          OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{x:Bind Name}" />
                                            <Button Grid.Column="3" Style="{StaticResource NerdyIconButtonStyle}" Width="28" Height="28" Command="{x:Bind RemoveCommand}"
                                                    Visibility="{x:Bind CanRemove}" ToolTipService.ToolTip="Remove from list" AutomationProperties.Name="Remove">
                                                <fi:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Allowed websites" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,2" Style="{StaticResource NerdyTextBase}" />
                            <TextBlock Text="One click away in the session dock. Browsers follow the app list above." Margin="0,0,0,8" Style="{StaticResource NerdyCaptionWrapStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Websites}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <tk:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WebsiteChip">
                                        <Border Background="{ThemeResource NerdyIconTileBrush}" CornerRadius="6" Padding="10,4,4,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind Site}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
                                                <Button Style="{StaticResource PlainButtonStyle}" Width="18" Height="18" CornerRadius="9" Command="{x:Bind RemoveCommand}"
                                                        ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove website">
                                                    <fi:SymbolIcon Symbol="Dismiss" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox PlaceholderText="Add a website and press Enter" Margin="0,10,0,0" Text="{x:Bind ViewModel.NewWebsite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnWebsiteKeyDown" AutomationProperties.Name="Add website" />
                            <Button Style="{StaticResource NerdyLinkButtonStyle}" Content="Change what happens to other apps" Margin="0,10,0,0" Padding="0" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="1" Padding="28,14" ColumnSpacing="14" Background="{ThemeResource NerdyPopupBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <fi:SymbolIcon Symbol="{x:Bind ViewModel.StartIcon, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource NerdyAccentBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource NerdyStrongStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Rule, Mode=OneWay}" Style="{StaticResource NerdyCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource NerdyAccentButtonStyle}" Height="40" Padding="22,0" CornerRadius="10" FontSize="15"
                    Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StartCommand}" />
        </Grid>
    </Grid>
</Page>
