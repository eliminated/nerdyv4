<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:h="using:Nerdy.App.Helpers">

    <Page.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource PlainButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Grid BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Padding="16,22,16,12" Spacing="10">
                <Grid>
                    <TextBlock Text="Notes" FontSize="20" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                    <Button Style="{StaticResource NerdyAccentButtonStyle}" Width="30" Height="30" Padding="0" HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.NewCommand}" ToolTipService.ToolTip="New note (Ctrl+N)" AutomationProperties.Name="New note">
                        <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="White" />
                    </Button>
                </Grid>
                <TextBox PlaceholderText="Search notes" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search notes" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.FilterOptions}" SelectedItem="{x:Bind ViewModel.Filter, Mode=TwoWay}" AutomationProperties.Name="Filter by subject or topic" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Padding="8,0,8,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoteListItemViewModel">
                                <Button Style="{StaticResource PlainButtonStyle}" Padding="12,10" CornerRadius="10" Margin="0,0,0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="{x:Bind Background}" Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Title}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                                        <TextBlock Text="{x:Bind Snippet}" Style="{StaticResource NerdyCaptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{x:Bind Dot}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Meta}" FontSize="11" Style="{StaticResource NerdyCaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No notes here yet." Margin="12" Visibility="{x:Bind h:B.Collapsed(ViewModel.HasNotes), Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Empty editor -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind h:B.Collapsed(ViewModel.HasNote), Mode=OneWay}">
            <fi:SymbolIcon Symbol="Notepad" FontSize="44" Foreground="{ThemeResource NerdyTextTertiaryBrush}" />
            <TextBlock Text="Capture what you're learning" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
            <Button Style="{StaticResource NerdyAccentButtonStyle}" HorizontalAlignment="Center" Content="New note" Command="{x:Bind ViewModel.NewCommand}" />
        </StackPanel>

        <!-- Editor -->
        <Grid Grid.Column="1" Background="{ThemeResource NerdyCardBackgroundBrush}" Visibility="{x:Bind ViewModel.HasNote, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="20,10" ColumnSpacing="8" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.SubjectDot, Mode=OneWay}" VerticalAlignment="Center" />
                <!-- Breadcrumb: subject › topic › subtopic; each further level shows once the one before has something to pick. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="130" ItemsSource="{x:Bind ViewModel.SubjectOptions}" SelectedItem="{x:Bind ViewModel.Subject, Mode=TwoWay}" AutomationProperties.Name="Subject" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasTopicOptions, Mode=OneWay}">
                        <fi:SymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox MinWidth="130" ItemsSource="{x:Bind ViewModel.TopicOptions}" SelectedItem="{x:Bind ViewModel.Topic, Mode=TwoWay}" AutomationProperties.Name="Topic" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasSubtopicOptions, Mode=OneWay}">
                        <fi:SymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox MinWidth="130" ItemsSource="{x:Bind ViewModel.SubtopicOptions}" SelectedItem="{x:Bind ViewModel.Subtopic, Mode=TwoWay}" AutomationProperties.Name="Subtopic" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource NerdyOutlineButtonStyle}" Height="30" FontSize="13" Command="{x:Bind ViewModel.FocusOnNoteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fi:SymbolIcon Symbol="TargetArrow" FontSize="16" />
                        <TextBlock Text="Focus on this note" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource NerdyIconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="20" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Delete note" Command="{x:Bind ViewModel.DeleteCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Padding="16,6" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,0,1">
                <ComboBox x:Name="StyleBox" Width="130" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="OnStyleChanged" AutomationProperties.Name="Paragraph style">
                    <x:String>Body</x:String>
                    <x:String>Heading</x:String>
                    <x:String>Subheading</x:String>
                </ComboBox>
                <Button Style="{StaticResource ToolbarButton}" Click="OnBold" ToolTipService.ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold"><fi:SymbolIcon Symbol="TextBold" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnItalic" ToolTipService.ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic"><fi:SymbolIcon Symbol="TextItalic" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnUnderline" ToolTipService.ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline"><fi:SymbolIcon Symbol="TextUnderline" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnBullets" ToolTipService.ToolTip="Bulleted list" AutomationProperties.Name="Bulleted list"><fi:SymbolIcon Symbol="TextBulletList" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnNumbers" ToolTipService.ToolTip="Numbered list" AutomationProperties.Name="Numbered list"><fi:SymbolIcon Symbol="TextNumberList" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnHighlight" ToolTipService.ToolTip="Highlight" AutomationProperties.Name="Highlight"><fi:SymbolIcon Symbol="Highlight" FontSize="20" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnClearFormatting" ToolTipService.ToolTip="Clear formatting" AutomationProperties.Name="Clear formatting"><fi:SymbolIcon Symbol="TextClearFormatting" FontSize="20" /></Button>
            </StackPanel>

            <ScrollViewer Grid.Row="2">
                <StackPanel MaxWidth="760" Padding="48,36,48,60" HorizontalAlignment="Stretch">
                    <TextBox x:Name="TitleBox" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Untitled note"
                             FontSize="30" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" AutomationProperties.Name="Title">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="{x:Bind ViewModel.EditedText, Mode=OneWay}" Margin="0,4,0,20" Style="{StaticResource NerdyCaptionStyle}" />
                    <RichEditBox x:Name="Body" MinHeight="240" BorderThickness="0" Background="Transparent" Padding="0" FontSize="15"
                                 PlaceholderText="Start writing…" TextChanged="OnBodyChanged" AutomationProperties.Name="Note body"
                                 IsSpellCheckEnabled="True" DisabledFormattingAccelerators="None">
                        <RichEditBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        </RichEditBox.Resources>
                    </RichEditBox>

                    <!-- Checklist -->
                    <StackPanel Margin="0,24,0,0" Spacing="6">
                        <TextBlock Text="Checklist" Style="{StaticResource NerdySectionLabelStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Checklist}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind Done, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{x:Bind Text, Mode=OneWay}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Text, Mode=TwoWay}" BorderThickness="0" Background="Transparent" FontSize="15"
                                                 VerticalAlignment="Center" Opacity="{x:Bind ItemOpacity, Mode=OneWay}" />
                                        <Button Grid.Column="2" Style="{StaticResource NerdyIconButtonStyle}" Width="28" Height="28" Command="{x:Bind RemoveCommand}"
                                                ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove item">
                                            <fi:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="{ThemeResource NerdyAccentBrush}" Margin="6,0,0,0" />
                            <TextBox Grid.Column="1" PlaceholderText="Add an item and press Enter" BorderThickness="0" Background="Transparent"
                                     Text="{x:Bind ViewModel.NewChecklistItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnChecklistKeyDown"
                                     AutomationProperties.Name="Add checklist item" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
