<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.SubjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:h="using:Nerdy.App.Helpers">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Subjects, each expandable to its topics -->
        <Grid BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,22,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,0,0,12">
                <TextBlock Text="Subjects" FontSize="20" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                <Button Style="{StaticResource NerdyIconButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddSubjectCommand}"
                        ToolTipService.ToolTip="New subject (Ctrl+N)" AutomationProperties.Name="New subject">
                    <fi:SymbolIcon Symbol="Add" FontSize="20" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tree}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubjectNodeViewModel">
                            <StackPanel>
                                <Button Style="{StaticResource PlainButtonStyle}" Height="36" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="{x:Bind RowBackground}" Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Name}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PlainButtonStyle}" Width="20" Height="20" CornerRadius="4" Command="{x:Bind ToggleCommand}"
                                                AutomationProperties.Name="Show topics">
                                            <fi:SymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                                <fi:SymbolIcon.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                                </fi:SymbolIcon.RenderTransform>
                                            </fi:SymbolIcon>
                                        </Button>
                                        <Rectangle Grid.Column="1" Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{x:Bind Color}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontWeight="{x:Bind Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource NerdyTextBase}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind TopicCount}" VerticalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}"
                                                   ToolTipService.ToolTip="Topics" />
                                    </Grid>
                                </Button>
                                <ItemsControl ItemsSource="{x:Bind Topics}" Padding="34,0,0,4" Visibility="{x:Bind IsExpanded, Mode=OneWay}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TopicLeafViewModel">
                                            <Button Style="{StaticResource PlainButtonStyle}" Padding="8,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{x:Bind OpenCommand}" AutomationProperties.Name="{x:Bind Name}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" Style="{StaticResource NerdyCaptionStyle}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- No subjects -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind h:B.Collapsed(ViewModel.HasSubjects), Mode=OneWay}">
            <fi:SymbolIcon Symbol="Library" FontSize="44" Foreground="{ThemeResource NerdyTextTertiaryBrush}" />
            <TextBlock Text="No subjects yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
            <TextBlock Text="Subjects hold your topics, study blocks, notes, reminders and focus time." Style="{StaticResource NerdySecondaryStyle}" />
            <Button Style="{StaticResource NerdyAccentButtonStyle}" HorizontalAlignment="Center" Content="Add a subject" Command="{x:Bind ViewModel.AddSubjectCommand}" />
        </StackPanel>

        <!-- The selected subject -->
        <ScrollViewer x:Name="Detail" Grid.Column="1" Padding="32,26" Visibility="{x:Bind ViewModel.HasSubjects, Mode=OneWay}">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="{x:Bind ViewModel.Tint, Mode=OneWay}">
                        <fi:SymbolIcon Symbol="Library" FontSize="28" Foreground="{x:Bind ViewModel.Color, Mode=OneWay}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Style="{StaticResource NerdyTextBase}" />
                        <TextBlock Text="{x:Bind ViewModel.Meta, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" FontSize="14" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource NerdyOutlineButtonStyle}" Command="{x:Bind ViewModel.ScheduleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="CalendarEdit" FontSize="16" />
                            <TextBlock Text="Schedule" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource NerdyAccentButtonStyle}" Command="{x:Bind ViewModel.NewNoteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="White" />
                            <TextBlock Text="New note" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource NerdyIconButtonStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                        <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="20" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Edit subject" Command="{x:Bind ViewModel.EditSubjectCommand}" />
                                <MenuFlyoutItem Text="Delete subject" Command="{x:Bind ViewModel.DeleteSubjectCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,24">
                    <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="Clock" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NextText, Mode=OneWay}" FontSize="13" Style="{StaticResource NerdyTextBase}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8"
                            Visibility="{x:Bind ViewModel.HasDue, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="Flag" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DueText, Mode=OneWay}" FontSize="13" Style="{StaticResource NerdyTextBase}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="Timer" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FocusText, Mode=OneWay}" FontSize="13" Style="{StaticResource NerdyTextBase}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Topics" Style="{StaticResource NerdyCardTitleStyle}" Margin="0,0,0,10" />
                <TextBlock Text="{x:Bind ViewModel.NoTopicsText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource NerdySecondaryStyle}"
                           Visibility="{x:Bind h:B.Collapsed(ViewModel.HasTopics), Mode=OneWay}" />

                <ItemsControl x:Name="TopicCards" ItemsSource="{x:Bind ViewModel.Topics}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopicCardViewModel">
                            <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <!-- Topic header -->
                                    <Grid ColumnSpacing="20" Padding="18,12" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource NerdyTextBase}" />
                                        <Grid Grid.Column="1" ColumnSpacing="10" Visibility="{x:Bind HasProgress, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <controls:ProgressTrack Value="{x:Bind Progress, Mode=OneWay}" Fill="{x:Bind Color}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource NerdyCaptionStyle}" />
                                        </Grid>
                                        <Button Grid.Column="2" Style="{StaticResource PlainButtonStyle}" Padding="6,4" HorizontalAlignment="Left" Command="{x:Bind OpenNotesCommand}"
                                                ToolTipService.ToolTip="Open this topic's notes">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fi:SymbolIcon Symbol="Notepad" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind NotesText, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource NerdyIconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Topic options"
                                                AutomationProperties.Name="Topic options">
                                            <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="16" />
                                            <Button.Flyout>
                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                    <StackPanel Width="260" Spacing="12">
                                                        <TextBox Header="Topic name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Content="New note in this topic" Command="{x:Bind NewNoteCommand}" HorizontalAlignment="Stretch" Style="{StaticResource NerdyOutlineButtonStyle}" />
                                                        <Button Content="Schedule this topic" Command="{x:Bind ScheduleCommand}" HorizontalAlignment="Stretch" Style="{StaticResource NerdyOutlineButtonStyle}" />
                                                        <Button Content="Delete topic" Command="{x:Bind DeleteCommand}" HorizontalAlignment="Stretch" Style="{StaticResource NerdyOutlineButtonStyle}"
                                                                Foreground="{ThemeResource NerdyDangerTextBrush}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <!-- Subtopics -->
                                    <ItemsControl ItemsSource="{x:Bind Subtopics}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SubtopicRowViewModel">
                                                <Grid ColumnSpacing="20" Padding="34,10,18,10" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource NerdyTextBase}" />
                                                    <Grid Grid.Column="1" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="36" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:ProgressTrack Value="{x:Bind Progress, Mode=OneWay}" Fill="{x:Bind Color}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind PercentText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}" />
                                                    </Grid>
                                                    <Button Grid.Column="2" Style="{StaticResource PlainButtonStyle}" Padding="6,4" HorizontalAlignment="Left" Command="{x:Bind OpenNotesCommand}"
                                                            ToolTipService.ToolTip="Open notes">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <fi:SymbolIcon Symbol="Notepad" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind NotesText}" Style="{StaticResource NerdySecondaryStyle}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource NerdyIconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit subtopic">
                                                        <fi:SymbolIcon Symbol="Edit" FontSize="16" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="LeftEdgeAlignedTop">
                                                                <StackPanel Width="260" Spacing="12">
                                                                    <TextBox Header="Name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Slider Header="Progress" Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind Progress, Mode=TwoWay}" />
                                                                    <Button Content="Delete subtopic" Command="{x:Bind DeleteCommand}" Style="{StaticResource NerdyOutlineButtonStyle}"
                                                                            Foreground="{ThemeResource NerdyDangerTextBrush}" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnSpacing="10" Padding="34,6,18,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="{ThemeResource NerdyAccentBrush}" />
                                        <TextBox Grid.Column="1" PlaceholderText="Add subtopic and press Enter" BorderThickness="0" Background="Transparent"
                                                 Text="{x:Bind NewSubtopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNewSubtopicKeyDown"
                                                 AutomationProperties.Name="Add subtopic" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- New topic -->
                <Border Margin="0,12,0,0" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="{ThemeResource NerdyAccentBrush}" />
                        <TextBox Grid.Column="1" PlaceholderText="Add topic and press Enter" BorderThickness="0" Background="Transparent"
                                 Text="{x:Bind ViewModel.NewTopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNewTopicKeyDown"
                                 AutomationProperties.Name="Add topic" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
