<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.UltraFocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    RequestedTheme="Dark"
    FontFamily="{x:Bind Theme.FontFamily, Mode=OneWay}">

    <Grid x:Name="Root" Background="#14132B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border HorizontalAlignment="Center" Margin="0,28,0,0" Padding="16,7" CornerRadius="16" Background="#1AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fi:SymbolIcon Symbol="LockClosed" FontSize="16" Foreground="White" />
                <TextBlock Text="Ultra-Focus · Locked" FontSize="13" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.TaskTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.TopicName, Mode=OneWay}" FontSize="13" Foreground="#C7FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <Grid Width="360" Height="360">
                <controls:TimerRing x:Name="Ring" Value="{x:Bind ViewModel.Remaining, Mode=OneWay}" Thickness="6" TrackBrush="#14FFFFFF" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" FontSize="80" FontWeight="SemiBold" CharacterSpacing="-20" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EndsText, Mode=OneWay}" Foreground="#C7FFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <TextBlock Text="No pausing. No ending early. You've got this." FontSize="14" Foreground="#C7FFFFFF" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,28" Padding="8" CornerRadius="16" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Dock}" IsTabStop="False" ItemsPanel="{StaticResource NerdyHorizontalPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DockItem">
                            <Button Style="{StaticResource PlainButtonStyle}" Width="44" Height="44" CornerRadius="12" Margin="0,0,6,0" Background="#1AFFFFFF"
                                    Command="{x:Bind OpenCommand}" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                                <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="22" Foreground="White" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Allowed apps" FontSize="12" Foreground="#C7FFFFFF" Margin="10,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="10,6"
                Command="{x:Bind ViewModel.OpenExitCommand}" AutomationProperties.Name="Emergency exit">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:SymbolIcon Symbol="Warning" FontSize="16" Foreground="#B3FFFFFF" />
                <TextBlock Text="Emergency exit" FontSize="13" Foreground="#B3FFFFFF" />
            </StackPanel>
        </Button>

        <!-- Emergency exit -->
        <Grid Grid.RowSpan="3" Background="#8C080814" Visibility="{x:Bind ViewModel.IsExitOpen, Mode=OneWay}">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="#FFFFFF" RequestedTheme="Light">
                <StackPanel>
                    <StackPanel Padding="26,24,26,8" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FDECEA">
                                <fi:SymbolIcon Symbol="Warning" FontSize="20" Foreground="#C42B1C" />
                            </Border>
                            <TextBlock Text="Exit Ultra-Focus early?" FontSize="20" FontWeight="SemiBold" Foreground="#1B1B1F" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Ultra-Focus is meant to be hard to leave. Tell us what's going on. This exit will be noted in your focus history."
                                   FontSize="13" Foreground="#5F5F6B" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <RadioButtons ItemsSource="{x:Bind ViewModel.ExitReasonLabels}" SelectedIndex="{x:Bind ViewModel.ExitReasonIndex, Mode=TwoWay}" Margin="0,0,0,10" />
                        <TextBox x:Name="ExitBox" PlaceholderText="{x:Bind ViewModel.ExitPlaceholder, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                                 Text="{x:Bind ViewModel.ExitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="What happened" />
                        <TextBlock Text="{x:Bind ViewModel.ExitHint, Mode=OneWay}" FontSize="12" Foreground="#5F5F6B" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <!-- AI review said this can wait -->
                        <Border Visibility="{x:Bind ViewModel.HasReviewMessage, Mode=OneWay}" Margin="0,12,0,0" Padding="14,12" CornerRadius="10" Background="#EEF0FD">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <fi:SymbolIcon Symbol="Sparkle" FontSize="18" Foreground="#4F46E5" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ReviewMessage, Mode=OneWay}" FontSize="13" Foreground="#1B1B1F" TextWrapping="Wrap" />
                                    <TextBlock Text="Reviewed by Claude (AI). If something has changed, add details and hold again." FontSize="11" Foreground="#5F5F6B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Grid Padding="26,16,26,22" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource NerdyAccentButtonStyle}" Height="42" CornerRadius="10" HorizontalAlignment="Stretch" Content="Stay focused"
                                Command="{x:Bind ViewModel.CloseExitCommand}" />
                        <Button x:Name="HoldButton" Grid.Column="1" Style="{StaticResource PlainButtonStyle}" Height="42" CornerRadius="10" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="White" BorderBrush="#C42B1C" BorderThickness="1"
                                Opacity="{x:Bind ViewModel.HoldOpacity, Mode=OneWay}" AutomationProperties.Name="Hold to exit"
                                AutomationProperties.HelpText="Press and hold for three seconds, or hold the Enter key">
                            <Grid>
                                <controls:ProgressTrack Value="{x:Bind ViewModel.HoldPercent, Mode=OneWay}" Fill="#FBD9D5" Height="40" VerticalAlignment="Stretch" CornerRadius="0" IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsReviewing, Mode=OneWay}" Foreground="#C42B1C"
                                                  Visibility="{x:Bind ViewModel.IsReviewing, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.HoldLabel, Mode=OneWay}" Foreground="#C42B1C" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
