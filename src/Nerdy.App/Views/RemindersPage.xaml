<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:items="using:Nerdy.App.ViewModels.Items">

    <ScrollViewer Padding="28,22,28,28">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Width="860">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Reminders" FontSize="24" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                <Border Style="{StaticResource NerdySegmentTrackStyle}" HorizontalAlignment="Right" CornerRadius="10">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Filters}" ItemTemplate="{StaticResource NerdySegmentTemplate}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
                </Border>
            </Grid>

            <!-- Quick add -->
            <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="10"
                    Height="44" Padding="14,0" Margin="0,0,0,20">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <fi:SymbolIcon Symbol="Add" FontSize="20" Foreground="{ThemeResource NerdyAccentBrush}" />
                    <TextBox x:Name="QuickAdd" Grid.Column="1" PlaceholderText="Add a reminder and press Enter" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" Padding="0,5" Text="{x:Bind ViewModel.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnQuickAddKeyDown" AutomationProperties.Name="New reminder">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.DueOptions}" SelectedItem="{x:Bind ViewModel.NewDue, Mode=TwoWay}"
                              VerticalAlignment="Center" MinWidth="120" AutomationProperties.Name="Due" />
                </Grid>
            </Border>

            <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Spacing="8" HorizontalAlignment="Center" Margin="0,40">
                <fi:SymbolIcon Symbol="Alert" FontSize="40" Foreground="{ThemeResource NerdyTextTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource NerdySecondaryStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReminderGroup">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{x:Bind Header}" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,6" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                            <Border Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1" CornerRadius="12">
                                <ItemsControl ItemsSource="{x:Bind Items}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="items:ReminderItemViewModel">
                                            <Grid ColumnSpacing="14" Padding="16,12" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource PlainButtonStyle}" Width="20" Height="20" CornerRadius="10"
                                                        Background="{x:Bind CheckBackground, Mode=OneWay}" BorderBrush="{x:Bind CheckBorder, Mode=OneWay}" BorderThickness="1.5"
                                                        Command="{x:Bind ToggleDoneCommand}" AutomationProperties.Name="Mark done">
                                                    <fi:SymbolIcon Symbol="Checkmark" FontSize="14" Foreground="White" Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                                </Button>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{x:Bind TitleBrush, Mode=OneWay}" TextDecorations="{x:Bind Decorations, Mode=OneWay}" Style="{StaticResource NerdyTextBase}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <fi:SymbolIcon Symbol="HatGraduation" FontSize="14" Foreground="{x:Bind DotBrush}" Visibility="{x:Bind IsAssignment}" />
                                                            <Ellipse Width="7" Height="7" Fill="{x:Bind DotBrush}" VerticalAlignment="Center" Visibility="{x:Bind IsPersonal}" />
                                                            <TextBlock Text="{x:Bind ContextText}" Style="{StaticResource NerdyCaptionStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <fi:SymbolIcon Symbol="Clock" FontSize="14" Foreground="{x:Bind DueBrush, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind DueText}" FontSize="12" Foreground="{x:Bind DueBrush, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasNotes}">
                                                            <fi:SymbolIcon Symbol="Note" FontSize="14" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind Notes}" MaxWidth="260" Style="{StaticResource NerdyCaptionStyle}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource NerdyIconButtonStyle}" Width="32" Height="32" Visibility="{x:Bind IsPersonal}"
                                                        Command="{x:Bind ToggleStarCommand}" ToolTipService.ToolTip="Star" AutomationProperties.Name="Star">
                                                    <fi:SymbolIcon Symbol="Star" FontSize="20" IconVariant="{x:Bind StarVariant, Mode=OneWay}" Foreground="{x:Bind StarBrush, Mode=OneWay}" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource NerdyIconButtonStyle}" Width="32" Height="32" Visibility="{x:Bind IsPersonal}"
                                                        ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                                                    <fi:SymbolIcon Symbol="MoreHorizontal" FontSize="18" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Edit" Click="OnEdit" Tag="{x:Bind}" />
                                                            <MenuFlyoutItem Text="Delete" Command="{x:Bind DeleteCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
