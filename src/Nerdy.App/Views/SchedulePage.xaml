<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:common="using:Nerdy.App.ViewModels.Common"
    xmlns:h="using:Nerdy.App.Helpers">

    <Page.Resources>
        <DataTemplate x:Key="DayCircleTemplate" x:DataType="common:ChoiceItem">
            <Button Style="{StaticResource PlainButtonStyle}" Width="38" Height="38" CornerRadius="19" Margin="0,0,8,0"
                    Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}" BorderThickness="1"
                    Command="{x:Bind SelectCommand}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ToolTip, Mode=OneWay}">
                <TextBlock Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind Foreground, Mode=OneWay}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PlanRowTemplate" x:DataType="vm:PlanRowViewModel">
            <Border Background="{x:Bind Background}" BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                <StackPanel Spacing="7">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fi:SymbolIcon Symbol="{x:Bind Icon}" FontSize="16" Foreground="{x:Bind IconBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DateText}" FontSize="13" FontWeight="SemiBold" TextDecorations="{x:Bind Decorations}" Style="{StaticResource NerdyTextBase}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" TextDecorations="{x:Bind Decorations}" Style="{StaticResource NerdySecondaryStyle}" />
                        <Border Grid.Column="3" Background="{x:Bind PillBackground}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind PillForeground}" />
                        </Border>
                        <Button Grid.Column="4" Style="{StaticResource NerdyLinkButtonStyle}" FontSize="12" FontWeight="SemiBold" Content="Undo"
                                Visibility="{x:Bind CanUndo}" Command="{x:Bind UndoCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Reason}" FontSize="12" Foreground="{x:Bind ReasonBrush}" Margin="26,0,0,0" TextWrapping="Wrap" Visibility="{x:Bind HasReason}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="26,0,0,0" Visibility="{x:Bind IsConflict}">
                        <TextBlock Text="{x:Bind SuggestionText}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}" />
                        <ItemsControl ItemsSource="{x:Bind Suggestions}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SuggestionChip">
                                    <Button Style="{StaticResource PlainButtonStyle}" Height="26" Padding="10,0" CornerRadius="13"
                                            Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyAccentBrush}" BorderThickness="1"
                                            Command="{x:Bind PickCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <fi:SymbolIcon Symbol="ArrowRight" FontSize="14" Foreground="{ThemeResource NerdyAccentTextBrush}" />
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NerdyAccentTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource PlainButtonStyle}" Height="26" Padding="10,0" CornerRadius="13" Content="Skip" FontSize="12"
                                Background="{ThemeResource NerdyCardBackgroundBrush}" BorderBrush="{ThemeResource NerdyChipBorderBrush}" BorderThickness="1"
                                Command="{x:Bind SkipCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Padding="28,22,28,16">
            <Button Style="{StaticResource PlainButtonStyle}" Padding="4,0" Command="{x:Bind ViewModel.CancelCommand}">
                <TextBlock Text="Calendar" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
            </Button>
            <fi:SymbolIcon Symbol="ChevronRight" FontSize="16" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
            <TextBlock Text="New study block" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Form ===== -->
            <Border Style="{StaticResource NerdyCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="22,20">
                        <StackPanel Spacing="18">
                            <TextBox Header="Title" Style="{StaticResource NerdyTextBoxStyle}" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Topic" Style="{StaticResource NerdySectionLabelStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopicChips}" ItemTemplate="{StaticResource NerdyColorChipTemplate}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <tk:WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="How often" Style="{StaticResource NerdySectionLabelStyle}" />
                                <Border Style="{StaticResource NerdySegmentTrackStyle}" HorizontalAlignment="Stretch" CornerRadius="10">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ScopeSegments}" ItemTemplate="{StaticResource NerdyFillSegmentTemplate}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <tk:UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.ScopeDescription, Mode=OneWay}" Style="{StaticResource NerdyCaptionWrapStyle}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.DaysLabel, Mode=OneWay}" Style="{StaticResource NerdySectionLabelStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DayChips}" ItemTemplate="{StaticResource DayCircleTemplate}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="Starts" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.StartOptions}" SelectedItem="{x:Bind ViewModel.Start, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="Remind me" HorizontalAlignment="Stretch" ItemsSource="{x:Bind vm:ScheduleViewModel.ReminderOptions}" SelectedItem="{x:Bind ViewModel.Reminder, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Duration" Style="{StaticResource NerdySectionLabelStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DurationChips}" ItemTemplate="{StaticResource NerdyChipTemplate}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <tk:WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Visibility="{x:Bind ViewModel.IsCustomDuration, Mode=OneWay}" Padding="14" CornerRadius="12"
                                        Background="{ThemeResource NerdyCardAltBackgroundBrush}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.CustomSummary, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Style="{StaticResource NerdyTextBase}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="Hours" Minimum="0" Maximum="12" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CustomHours, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" Header="Minutes" Minimum="0" Maximum="59" SmallChange="5" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CustomMinutes, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border CornerRadius="10" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Padding="14,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <fi:SymbolIcon Symbol="TargetArrow" FontSize="20" Foreground="{ThemeResource NerdyTextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Start a focus session automatically" FontWeight="Medium" Style="{StaticResource NerdyTextBase}" />
                                            <TextBlock Text="Nerdy asks for confirmation 1 min before" Style="{StaticResource NerdyCaptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.AutoFocus, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Start a focus session automatically" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ModeChoices}" ItemTemplate="{StaticResource NerdyChipTemplate}" Padding="14,0,14,4"
                                                  Visibility="{x:Bind ViewModel.AutoFocus, Mode=OneWay}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Padding="22,14" ColumnSpacing="12" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <fi:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{ThemeResource NerdyDangerTextBrush}" Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SaveHint, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxWidth="180"
                                       Foreground="{x:Bind h:B.Brush(ViewModel.HasAttention, 'NerdyDangerTextBrush', 'NerdyTextSecondaryBrush'), Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource NerdyOutlineButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource NerdyAccentButtonStyle}" Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Preview ===== -->
            <Border Grid.Column="1" Style="{StaticResource NerdyCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="14" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.PreviewTitle, Mode=OneWay}" Style="{StaticResource NerdyStrongStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource NerdyIconButtonStyle}" Width="28" Height="28" Command="{x:Bind ViewModel.PreviousRangeCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" ToolTipService.ToolTip="Earlier" AutomationProperties.Name="Earlier">
                                <fi:SymbolIcon Symbol="ChevronLeft" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource NerdyIconButtonStyle}" Width="28" Height="28" Command="{x:Bind ViewModel.NextRangeCommand}"
                                    ToolTipService.ToolTip="Plan further ahead" AutomationProperties.Name="Later">
                                <fi:SymbolIcon Symbol="ChevronRight" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="12" Height="12" RadiusX="4" RadiusY="4" Fill="{ThemeResource NerdyAccentTint14Brush}" Stroke="{ThemeResource NerdyAccentBrush}" StrokeThickness="1.5" StrokeDashArray="2,1" />
                            <TextBlock Text="New" Style="{StaticResource NerdyCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="12" Height="12" RadiusX="4" RadiusY="4" Fill="{ThemeResource NerdyDangerSoftBrush}" Stroke="{ThemeResource NerdyDangerBrush}" StrokeThickness="1.5" StrokeDashArray="2,1" />
                            <TextBlock Text="Conflict" Style="{StaticResource NerdyCaptionStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.PreviewDays}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewDay">
                                    <TextBlock Text="{x:Bind Header}" FontSize="12" HorizontalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="2" Height="{x:Bind ViewModel.PreviewHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewHours}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:TimeGridPanel HourHeight="26" Inset="0" Loaded="OnPreviewPanelLoaded" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LineSlot">
                                    <TextBlock Text="{x:Bind Label}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource NerdyCaptionStyle}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="-7" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.PreviewDays}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewDay">
                                    <Grid Background="{x:Bind Background}" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="1,0,0,0">
                                        <ItemsControl ItemsSource="{x:Bind Lines}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:TimeGridPanel HourHeight="26" Inset="0" Loaded="OnPreviewPanelLoaded" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LineSlot">
                                                    <Rectangle Height="1" Fill="{ThemeResource NerdyDividerBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{x:Bind Blocks}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:TimeGridPanel HourHeight="26" Inset="3" MinItemHeight="10" Loaded="OnPreviewPanelLoaded" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PreviewBlock">
                                                    <Grid Opacity="{x:Bind Opacity}">
                                                        <Rectangle RadiusX="6" RadiusY="6" Fill="{x:Bind Fill}" Stroke="{x:Bind Stroke}" StrokeThickness="1.5" StrokeDashArray="{x:Bind Dash}" />
                                                        <TextBlock Text="{x:Bind Label}" FontSize="10" FontWeight="SemiBold" Margin="5,3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{x:Bind Foreground}" LineHeight="12" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,4">
                        <TextBlock Text="Sessions" Style="{StaticResource NerdyStrongStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource NerdyCaptionStyle}" />
                    </Grid>
                    <ScrollViewer Grid.Row="4">
                        <StackPanel>
                            <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Padding="14" CornerRadius="10" BorderBrush="{ThemeResource NerdyChipBorderBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextAlignment="Center" Style="{StaticResource NerdySecondaryWrapStyle}" />
                            </Border>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplate="{StaticResource PlanRowTemplate}" IsTabStop="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Clash dialog shown when saving with unresolved conflicts -->
        <ContentDialog x:Name="ConflictDialog" Grid.RowSpan="2"
                       Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
                       PrimaryButtonText="{x:Bind ViewModel.DialogPrimary, Mode=OneWay}"
                       SecondaryButtonText="Skip these &amp; add"
                       CloseButtonText="Keep editing"
                       DefaultButton="Primary">
            <StackPanel Width="500" Spacing="10">
                <TextBlock Text="Pick a replacement time for each one, or skip it. Suggestions only use free slots in your study day." Style="{StaticResource NerdySecondaryWrapStyle}" />
                <ScrollViewer MaxHeight="380">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ConflictRows, Mode=OneWay}" ItemTemplate="{StaticResource PlanRowTemplate}" IsTabStop="False" />
                </ScrollViewer>
                <Border Visibility="{x:Bind ViewModel.DialogClear, Mode=OneWay}" Background="{ThemeResource NerdySuccessSoftBrush}" CornerRadius="10" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="20" Foreground="{ThemeResource NerdySuccessTextBrush}" />
                        <TextBlock Text="All sessions have a free slot now." Foreground="{ThemeResource NerdySuccessTextBrush}" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
