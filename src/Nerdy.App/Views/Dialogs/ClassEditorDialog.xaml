<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Nerdy.App.Views.Dialogs.ClassEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nerdy.App.ViewModels"
    Title="{x:Bind ViewModel.DialogTitle}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">

    <StackPanel Spacing="14" Width="400">
        <TextBox Header="Class name" PlaceholderText="e.g. Biology 101, Period 3" MaxLength="80"
                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Subject (optional)" PlaceholderText="e.g. Biology" MaxLength="80" Text="{x:Bind ViewModel.Subject, Mode=TwoWay}" />
        <StackPanel Spacing="8">
            <TextBlock Text="Colour" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Swatches}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SwatchItem">
                        <Button Style="{StaticResource PlainButtonStyle}" Width="34" Height="34" CornerRadius="17" Command="{x:Bind PickCommand}" AutomationProperties.Name="{x:Bind Hex}">
                            <Border Width="34" Height="34" CornerRadius="17" BorderThickness="2" BorderBrush="{x:Bind Ring}" Padding="2">
                                <Ellipse Fill="{x:Bind Fill}" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</ContentDialog>
