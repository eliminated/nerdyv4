<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Nerdy.App.Views.Dialogs.AssignmentEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">

    <StackPanel Spacing="14" Width="460">
        <TextBox Header="Title" PlaceholderText="e.g. Read chapter 4 and answer questions 1–6" MaxLength="200"
                 Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Instructions (optional)" AcceptsReturn="True" TextWrapping="Wrap" Height="96" MaxLength="2000"
                 Text="{x:Bind ViewModel.Description, Mode=TwoWay}" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker Header="Due" HorizontalAlignment="Stretch" PlaceholderText="Pick a date" Date="{x:Bind ViewModel.DueDate, Mode=TwoWay}" />
            <TimePicker Grid.Column="1" Header="At" Time="{x:Bind ViewModel.DueTime, Mode=TwoWay}" />
        </Grid>
    </StackPanel>
</ContentDialog>
