<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nerdy.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fi="using:FluentIcons.WinUI"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Nerdy.App.Controls"
    xmlns:vm="using:Nerdy.App.ViewModels"
    xmlns:h="using:Nerdy.App.Helpers">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="DayColumnsPanel">
            <tk:UniformGrid Rows="1" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LinesPanel">
            <controls:TimeGridPanel HourHeight="52" Inset="0" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="EventsPanel">
            <controls:TimeGridPanel HourHeight="52" Inset="4" MinItemHeight="20" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ChipItem">
            <Button Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,2" CornerRadius="5"
                    Margin="0,0,0,3" Background="{x:Bind Background}" Command="{x:Bind OpenCommand}" ToolTipService.ToolTip="{x:Bind Title}">
                <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="{x:Bind Weight}" Foreground="{x:Bind Foreground}" Style="{StaticResource NerdyTextBase}" />
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="28,22,20,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource NerdyTextBase}" />
            <Button Grid.Column="1" Style="{StaticResource NerdyIconButtonStyle}" Width="32" Height="32" Command="{x:Bind ViewModel.PreviousCommand}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                <fi:SymbolIcon Symbol="ChevronLeft" FontSize="16" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource NerdyIconButtonStyle}" Width="32" Height="32" Command="{x:Bind ViewModel.NextCommand}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                <fi:SymbolIcon Symbol="ChevronRight" FontSize="16" />
            </Button>
            <Button Grid.Column="3" Style="{StaticResource NerdyOutlineButtonStyle}" Height="32" Padding="12,0" Content="Today" Command="{x:Bind ViewModel.GoTodayCommand}" />
            <Border Grid.Column="5" Style="{StaticResource NerdySegmentTrackStyle}" CornerRadius="10">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ViewSegments}" ItemTemplate="{StaticResource NerdySegmentTemplate}" ItemsPanel="{StaticResource NerdyHorizontalPanel}" IsTabStop="False" />
            </Border>
            <Button Grid.Column="6" Style="{StaticResource NerdyOutlineButtonStyle}" Command="{x:Bind ViewModel.NewEventCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="CalendarAdd" FontSize="16" />
                    <TextBlock Text="New event" />
                </StackPanel>
            </Button>
            <Button Grid.Column="7" Style="{StaticResource NerdyAccentButtonStyle}" Command="{x:Bind ViewModel.NewBlockCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="Add" FontSize="16" Foreground="White" />
                    <TextBlock Text="New block" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Day & week: time grid (+ side panel for day) -->
        <Grid Grid.Row="1" Margin="20,0" ColumnSpacing="16" Visibility="{x:Bind h:B.Collapsed(ViewModel.IsMonth), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource NerdyCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemsPanel="{StaticResource DayColumnsPanel}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayColumnViewModel">
                                    <StackPanel Padding="0,10" Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind DayName}" HorizontalAlignment="Center" Style="{StaticResource NerdyCaptionStyle}" />
                                        <Grid Width="30" Height="30" HorizontalAlignment="Center">
                                            <Ellipse Fill="{x:Bind NumberBackground}" />
                                            <TextBlock Text="{x:Bind DayNumber}" FontSize="15" FontWeight="SemiBold" Foreground="{x:Bind NumberForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- All-day and deadline strip -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HasAllDay, Mode=OneWay}" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="All day" FontSize="11" Margin="0,8,8,0" HorizontalAlignment="Right" Style="{StaticResource NerdyCaptionStyle}" />
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemsPanel="{StaticResource DayColumnsPanel}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayColumnViewModel">
                                    <ItemsControl ItemsSource="{x:Bind AllDay}" ItemTemplate="{StaticResource ChipTemplate}" Padding="4,6,4,3" IsTabStop="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ScrollViewer x:Name="TimeScroll" Grid.Row="2">
                        <Grid Height="{x:Bind ViewModel.GridHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HourLabels}" ItemsPanel="{StaticResource LinesPanel}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LineSlot">
                                        <TextBlock Text="{x:Bind Label}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource NerdyCaptionStyle}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="-7" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemsPanel="{StaticResource DayColumnsPanel}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayColumnViewModel">
                                        <Grid Background="{x:Bind ColumnBackground}" BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="1,0,0,0"
                                              DoubleTapped="OnColumnDoubleTapped" ToolTipService.Placement="Mouse">
                                            <ItemsControl ItemsSource="{x:Bind Lines}" ItemsPanel="{StaticResource LinesPanel}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LineSlot">
                                                        <Rectangle Height="1" Fill="{ThemeResource NerdyDividerBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{x:Bind Events}" ItemsPanel="{StaticResource EventsPanel}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EventSlot">
                                                        <Button Style="{StaticResource PlainButtonStyle}" CornerRadius="8" Padding="8,5" Background="{x:Bind Background}"
                                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                                Command="{x:Bind OpenCommand}" ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind Title}">
                                                            <StackPanel>
                                                                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="{x:Bind Weight}" Foreground="{x:Bind Foreground}" Style="{StaticResource NerdyTextBase}" />
                                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{x:Bind Foreground}" Style="{StaticResource NerdyTextBase}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{x:Bind Now}" ItemsPanel="{StaticResource LinesPanel}" IsTabStop="False" IsHitTestVisible="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LineSlot">
                                                        <Grid Height="9" Margin="-4,0,0,0">
                                                            <Grid.RenderTransform>
                                                                <TranslateTransform Y="-4.5" />
                                                            </Grid.RenderTransform>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="9" Height="9" Fill="{ThemeResource NerdyAccentBrush}" />
                                                            <Rectangle Grid.Column="1" Height="2" Fill="{ThemeResource NerdyAccentBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Day side panel -->
            <StackPanel Grid.Column="1" Width="300" Spacing="16" Visibility="{x:Bind ViewModel.IsDay, Mode=OneWay}">
                <Border Style="{StaticResource NerdyPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.MiniMonthTitle, Mode=OneWay}" Style="{StaticResource NerdyStrongStyle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WeekdayHeaders}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontSize="12" HorizontalAlignment="Center" Padding="0,4" Style="{StaticResource NerdyCaptionStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MiniMonth}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <tk:UniformGrid Columns="7" RowSpacing="2" ColumnSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonthCellViewModel">
                                    <Button Style="{StaticResource PlainButtonStyle}" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Center"
                                            Background="{x:Bind NumberBackground}" Opacity="{x:Bind Opacity}" Command="{x:Bind OpenDayCommand}">
                                        <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="{x:Bind Weight}" Foreground="{x:Bind NumberForeground}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource NerdyPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DayTitle, Mode=OneWay}" Style="{StaticResource NerdyStrongStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DaySummaryText, Mode=OneWay}" Margin="0,0,0,10" Style="{StaticResource NerdySecondaryStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DaySummary}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SummaryRow">
                                    <Grid ColumnSpacing="10" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind Dot}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" Style="{StaticResource NerdyTextBase}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource NerdySecondaryStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Month -->
        <Border Grid.Row="1" Margin="20,0" Style="{StaticResource NerdyCardStyle}" Padding="0" Visibility="{x:Bind ViewModel.IsMonth, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{x:Bind ViewModel.WeekdayHeaders}" IsTabStop="False" BorderBrush="{ThemeResource NerdyCardBorderBrush}" BorderThickness="0,0,0,1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <tk:UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Padding="12,10" Style="{StaticResource NerdyCaptionStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.MonthCells}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <tk:UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonthCellViewModel">
                            <Grid BorderBrush="{ThemeResource NerdyDividerBrush}" BorderThickness="0,0,1,1" Padding="6" Opacity="{x:Bind Opacity}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Style="{StaticResource PlainButtonStyle}" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,3"
                                        Background="{x:Bind NumberBackground}" Command="{x:Bind OpenDayCommand}" ToolTipService.ToolTip="Open day">
                                    <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind NumberForeground}" />
                                </Button>
                                <StackPanel Grid.Row="1">
                                    <ItemsControl ItemsSource="{x:Bind Chips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False" />
                                    <Button Style="{StaticResource PlainButtonStyle}" Padding="6,0" HorizontalAlignment="Left" Visibility="{x:Bind HasMore}" Command="{x:Bind OpenDayCommand}">
                                        <TextBlock Text="{x:Bind MoreText}" FontSize="11" Style="{StaticResource NerdyCaptionStyle}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Page>
