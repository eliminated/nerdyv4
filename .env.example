# Copy to .env (git-ignored) for docker compose. Development only - never reuse these values anywhere real.

# Password of the "sa" login of the local SQL Server container. SQL Server requires at least 8 characters
# from three of: upper case, lower case, digits, symbols. Avoid "$" (docker compose interpolates it).
MSSQL_SA_PASSWORD=Nerdy-Dev-Passw0rd
